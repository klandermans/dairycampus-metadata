  "dct:identifier": "doi:10.5281/zenodo.24092291",
  "dct:title": "Dairy Campus Research Data Platform: Central Data Catalog & Standardized Metadata Dictionaries",
  "dct:description": "Central research data catalog for the Dairy Campus experimental dairy cattle research infrastructure (Wageningen University & Research, Leeuwarden, The Netherlands). Continuously recorded since 2016 across an experimental herd of approximately 500 Holstein Friesian dairy cows. Encompasses millions of longitudinal milking parlor/robot transactions, individual load-cell roughage feed visits, computer-controlled concentrate feed allocations, high-frequency behavioral sensor states, GreenFeed enteric methane/CO2 fluxes, and milk composition records.",
  "dct:publisher": {
    "@type": "foaf:Organization",
    "foaf:name": "Dairy Campus, Wageningen University & Research",
    "foaf:homepage": "https://www.dairycampus.nl/"
  },
  "dct:creator": [
    {
      "@type": "foaf:Person",
      "foaf:name": "Bert Klandermans",
