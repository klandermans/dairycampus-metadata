<?xml version="1.0" ?>
<tableSchema xmlns="http://dairycampus.nl/schema/metadata/v1" xmlns:dct="http://purl.org/dc/terms/" xmlns:dcat="http://www.w3.org/ns/dcat#" id="Velos_behaviour" tableNumber="10">
  <header>
    <tableName>Velos_behaviour</tableName>
    <description>Nedap Velos Cow Behaviour Intervals (smarttag sensor state transitions for eating, ruminating, lying)</description>
    <sourceObject>T_RAW_velos_behaviour</sourceObject>
    <centralCatalogDoi>10.5281/zenodo.24092291</centralCatalogDoi>
    <catalogUrl>https://doi.org/10.5281/zenodo.24092291</catalogUrl>
    <distributionId>https://doi.org/10.5281/zenodo.24092291#distribution_Velos_behaviour</distributionId>
    <temporalSpan>2016-present</temporalSpan>
    <facility>Dairy Campus, Wageningen University &amp; Research, Leeuwarden, The Netherlands</facility>
    <targetPopulation>500 Holstein Friesian dairy cows</targetPopulation>
    <variableCount>4</variableCount>
    <license>https://creativecommons.org/licenses/by/4.0/</license>
  </header>
  <fields>
    <field position="1">
      <fieldName>date</fieldName>
      <dataType>date</dataType>
      <unit>yy-mm-dd</unit>
      <origin>Measured</origin>
      <description>Date of the data record, UTC timezone</description>
    </field>
    <field position="2">
      <fieldName>cow</fieldName>
      <dataType>integer</dataType>
      <unit>number</unit>
      <origin>Measured</origin>
      <description>Number on the ear tag of the animal, length 3-4 numbers. Derives from the registration number. Same as AnimalNo, is unique per date.</description>
    </field>
    <field position="3">
      <fieldName>type</fieldName>
      <dataType>string</dataType>
      <unit>short text</unit>
      <origin>Measured</origin>
      <description>Type of behaviour 1 - 3</description>
      <derivation>0, overig actief. 1, niet actief. 2, herkouwen. 3, vreten.</derivation>
    </field>
    <field position="4">
      <fieldName>duration</fieldName>
      <dataType>integer</dataType>
      <unit>sec</unit>
      <origin>Calculated</origin>
      <description>Duration of action/behaviour</description>
      <derivation>Calculated by endTime - startTime</derivation>
    </field>
  </fields>
</tableSchema>
