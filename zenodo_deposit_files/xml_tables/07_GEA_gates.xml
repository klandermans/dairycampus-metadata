<?xml version="1.0" ?>
<tableSchema xmlns="http://dairycampus.nl/schema/metadata/v1" xmlns:dct="http://purl.org/dc/terms/" xmlns:dcat="http://www.w3.org/ns/dcat#" id="GEA_gates" tableNumber="7">
  <header>
    <tableName>GEA_gates</tableName>
    <description>GEA Separation &amp; Smart Gate Passages (cow identification, routing decisions, sorting gate ID)</description>
    <sourceObject>T_RAW_Gea_Separatie</sourceObject>
    <centralCatalogDoi>10.5281/zenodo.24092291</centralCatalogDoi>
    <catalogUrl>https://doi.org/10.5281/zenodo.24092291</catalogUrl>
    <distributionId>https://doi.org/10.5281/zenodo.24092291#distribution_GEA_gates</distributionId>
    <temporalSpan>2016-present</temporalSpan>
    <facility>Dairy Campus, Wageningen University &amp; Research, Leeuwarden, The Netherlands</facility>
    <targetPopulation>500 Holstein Friesian dairy cows</targetPopulation>
    <variableCount>5</variableCount>
    <license>https://creativecommons.org/licenses/by/4.0/</license>
  </header>
  <fields>
    <field position="1">
      <fieldName>cow</fieldName>
      <dataType>integer</dataType>
      <unit>number</unit>
      <origin>Measured</origin>
      <description>Number on the ear tag of the animal, length 3-4 numbers. Derives from the registration number. Same as AnimalNo, is unique per date.</description>
    </field>
    <field position="2">
      <fieldName>date</fieldName>
      <dataType>date</dataType>
      <unit>yy-mm-dd</unit>
      <origin>Measured</origin>
      <description>Date of the data record</description>
    </field>
    <field position="3">
      <fieldName>event</fieldName>
      <dataType>integer</dataType>
      <unit>number</unit>
      <origin>Measured</origin>
      <description>0 = No gate action or weighting, 1 = selection gate A, 2 = selection gate B</description>
    </field>
    <field position="4">
      <fieldName>gate</fieldName>
      <dataType>integer</dataType>
      <unit>number</unit>
      <origin>Measured</origin>
      <description>Number of the gate</description>
    </field>
    <field position="5">
      <fieldName>message</fieldName>
      <dataType>string</dataType>
      <unit>tekst</unit>
      <origin>Measured</origin>
      <description>ID and info gate action, weighting or selection has or has not taken place</description>
    </field>
  </fields>
</tableSchema>
