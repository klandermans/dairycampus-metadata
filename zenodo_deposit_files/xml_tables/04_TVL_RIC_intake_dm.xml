<?xml version="1.0" ?>
<tableSchema xmlns="http://dairycampus.nl/schema/metadata/v1" xmlns:dct="http://purl.org/dc/terms/" xmlns:dcat="http://www.w3.org/ns/dcat#" id="TVL_RIC_intake_dm" tableNumber="4">
