<?xml version="1.0" ?>
<tableSchema xmlns="http://dairycampus.nl/schema/metadata/v1" xmlns:dct="http://purl.org/dc/terms/" xmlns:dcat="http://www.w3.org/ns/dcat#" id="Velos_behaviour_day" tableNumber="11">
  <header>
    <tableName>Velos_behaviour_day</tableName>
    <description>Nedap Velos Daily Cow Behaviour Summary (aggregated 24-hour durations of eating, ruminating, resting)</description>
    <sourceObject>T_RAW_velos_behaviour</sourceObject>
    <centralCatalogDoi>10.5281/zenodo.24092291</centralCatalogDoi>
    <catalogUrl>https://doi.org/10.5281/zenodo.24092291</catalogUrl>
    <distributionId>https://doi.org/10.5281/zenodo.24092291#distribution_Velos_behaviour_day</distributionId>
    <temporalSpan>2016-present</temporalSpan>
    <facility>Dairy Campus, Wageningen University &amp; Research, Leeuwarden, The Netherlands</facility>
    <targetPopulation>500 Holstein Friesian dairy cows</targetPopulation>
    <variableCount>7</variableCount>
    <license>https://creativecommons.org/licenses/by/4.0/</license>
  </header>
  <fields>
    <field position="1">
      <fieldName>date</fieldName>
      <dataType>date</dataType>
      <unit>yyyy-mm-dd</unit>
      <origin>Measured</origin>
      <description>Date of the data record, UTC timezone</description>
    </field>
    <field position="2">
      <fieldName>cow</fieldName>
      <dataType>integer</dataType>
      <unit>number</unit>
      <origin>Measured</origin>
      <description>Number on the ear tag of the animal, length 3-4 numbers. Derives from the registration number. Same as AnimalNo, is unique per date.</description>
    </field>
    <field position="3">
      <fieldName>total</fieldName>
      <dataType>number</dataType>
      <unit>hh-mm-ss</unit>
      <origin>Calculated</origin>
      <description>Total time recorded of the animal 1 day</description>
      <derivation>Sum duration of all types</derivation>
      <sourceObject>T_RAW_velos_behaviour</sourceObject>
    </field>
    <field position="4">
      <fieldName>overig</fieldName>
      <dataType>number</dataType>
      <unit>hh-mm-ss</unit>
      <origin>Calculated</origin>
      <description>Time the cow is actief but not eating or ruminating</description>
      <derivation>Sum duration of type 0</derivation>
      <sourceObject>T_RAW_velos_behaviour</sourceObject>
    </field>
    <field position="5">
      <fieldName>nietactief</fieldName>
      <dataType>number</dataType>
      <unit>hh-mm-ss</unit>
      <origin>Calculated</origin>
      <description>Time the cow is inactief</description>
      <derivation>Sum duration of type 1</derivation>
      <sourceObject>T_RAW_velos_behaviour</sourceObject>
    </field>
    <field position="6">
      <fieldName>herkouwen</fieldName>
      <dataType>number</dataType>
      <unit>hh-mm-ss</unit>
      <origin>Calculated</origin>
      <description>Time the cow spent ruminating</description>
      <derivation>Sum duration of type 2</derivation>
      <sourceObject>T_RAW_velos_behaviour</sourceObject>
    </field>
    <field position="7">
      <fieldName>vreten</fieldName>
      <dataType>number</dataType>
      <unit>hh-mm-ss</unit>
      <origin>Calculated</origin>
      <description>Time the cow spent eating</description>
      <derivation>Sum duration of type 3</derivation>
      <sourceObject>T_RAW_velos_behaviour</sourceObject>
    </field>
  </fields>
</tableSchema>
